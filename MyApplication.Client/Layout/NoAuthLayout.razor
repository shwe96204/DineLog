@using Fluxor
@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="@_theme" />
<MudSnackbarProvider />

    <div class="auth-layout-shell">
        <div class="auth-scene-glow auth-scene-glow-one"></div>
       
        <div class="auth-scene-glow auth-scene-glow-two"></div>

        <div id="particleContainer" style="position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:1;"></div>
            
        @Body

        <button type="button" class="gift-icon gift-icon-button" @onclick="OpenWelcomePage">
            <img src="image/book.gif" width="30px" />
            <span>capture relfections</span>
        </button>

    </div>

@code{
    protected override async Task OnInitializedAsync()
    {
        await JsInterop.EnsureBeforeLoginScriptsLoadedAsync();  
        await InvokeAsync(StateHasChanged); 
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            StateHasChanged();
            await JSRuntime.InvokeVoidAsync(identifier: "floatingAnimation.createParticles");
        }
    }

    private MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#b85042",
            Secondary = "#6d8b74",
            Tertiary = "#d9a35f",
            Background = "#f7f2eb",
            Surface = "#fffdf9",
            AppbarBackground = "#fffdf9",
            DrawerBackground = "#f4ede4",
            DrawerText = "#594236",
            DrawerIcon = "#7b5b4d",
            TextPrimary = "#2f241c",
            TextSecondary = "#7f6859",
            ActionDefault = "#8e705f",
            ActionDisabled = "#c8b6a8",
            Divider = "rgba(110, 77, 55, 0.14)",
            GrayLight = "#eadfd3",
            GrayLighter = "#f8f4ee",
            Info = "#6f8da1",
            Success = "#6d8b74",
            Warning = "#d89d43",
            Error = "#b85042"
        },
        LayoutProperties = new LayoutProperties
        {
            DrawerWidthLeft = "112px"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["DM Sans", "sans-serif"]
            },
            H1 = new H1Typography
            {
                FontFamily = ["Cormorant Garamond", "serif"],
                FontWeight = "700"
            },
            H2 = new H2Typography
            {
                FontFamily = ["Cormorant Garamond", "serif"],
                FontWeight = "700"
            },
            H3 = new H3Typography
            {
                FontFamily = ["Cormorant Garamond", "serif"],
                FontWeight = "700"
            },
            H4 = new H4Typography
            {
                FontFamily = ["Cormorant Garamond", "serif"],
                FontWeight = "700"
            },
            H5 = new H5Typography
            {
                FontFamily = ["Cormorant Garamond", "serif"],
                FontWeight = "700"
            },
            H6 = new H6Typography
            {
                FontFamily = ["Cormorant Garamond", "serif"],
                FontWeight = "700"
            }
        }
    };

    private void OpenWelcomePage()
    {
        var currentPath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var encodedReturnUrl = Uri.EscapeDataString($"/{currentPath}".Replace("//", "/"));
        NavigationManager.NavigateTo($"/welcome?returnUrl={encodedReturnUrl}");
    }

}
