@page "/reset-password"
@layout NoAuthLayout
@inject JournalAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Reset Password</PageTitle>

@if (isLoading)
{
    <div class="auth-scene">
        <div class="auth-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
            <p>Preparing password reset...</p>
        </div>
    </div>
}
else
{
    <div class="auth-scene">
        <div class="auth-card">
            <section class="auth-form-panel">
                <div class="auth-form-header">
                    <span class="auth-form-badge">New Password</span>
                    <h2>Create your new password</h2>
                    <p>OTP verified for @email. You can safely update your password now.</p>
                </div>

                <MudStack Spacing="3">
                    <MudTextField @bind-Value="newPassword"
                                  Label="New password"
                                  Variant="Variant.Outlined"
                                  InputType="@(showPassword ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="TogglePassword"
                                  Class="auth-input" />

                    <MudTextField @bind-Value="confirmPassword"
                                  Label="Confirm new password"
                                  Variant="Variant.Outlined"
                                  InputType="@(showPassword2 ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(showPassword2 ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="TogglePassword2"
                                  Class="auth-input" />

                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <MudAlert Severity="@messageSeverity" Variant="Variant.Outlined" Dense="true">
                            @message
                        </MudAlert>
                    }

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Size="Size.Large"
                               Class="auth-submit"
                               EndIcon="@Icons.Material.Filled.Password"
                               OnClick="HandleResetPasswordAsync">
                        Change Password
                    </MudButton>
                </MudStack>

                <div class="auth-footer">
                    <span>Need another code?</span>
                    <MudLink Href="@($"/otp-verification?flow=reset&email={Uri.EscapeDataString(email)}")">Back to OTP verification</MudLink>
                </div>
            </section>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    private string email = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string? message;
    private Severity messageSeverity = Severity.Info;
    private bool isLoading = true;
    private bool showPassword;
    private bool showPassword2;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        email = Email ?? await AuthService.GetLastEmailAsync() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(email))
        {
            NavigationManager.NavigateTo("/login", forceLoad: false);
            return;
        }

        isLoading = false;
        StateHasChanged();
    }

    private void TogglePassword() => showPassword = !showPassword;

    private void TogglePassword2() => showPassword2 = !showPassword2;

    private async Task HandleResetPasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            message = "Please complete both password fields.";
            messageSeverity = Severity.Warning;
            return;
        }

        if (newPassword.Length < 6)
        {
            message = "Password must be at least 6 characters.";
            messageSeverity = Severity.Warning;
            return;
        }

        if (newPassword != confirmPassword)
        {
            message = "Passwords do not match.";
            messageSeverity = Severity.Error;
            return;
        }

        var result = await AuthService.ResetPasswordAsync(email.Trim(), newPassword);
        message = result.Message;
        messageSeverity = result.Success ? Severity.Success : Severity.Error;

        if (result.Success)
        {
            NavigationManager.NavigateTo($"/login?email={Uri.EscapeDataString(email.Trim())}&reset=1", forceLoad: false);
        }
    }
}
